# Copia este archivo a .env.local (desarrollo) y configura las mismas
# variables en Vercel (Settings > Environment Variables) para producción.

# Se obtienen en Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://yodqhbjsgmwpbmzwkbij.supabase.co/rest/v1/
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_TpfNhk1jNTmatsIYLHcjGA_U7o9brxf

# Service Role Key (Project Settings > API > "service_role" secret).
# Le da acceso TOTAL a la base de datos y permite crear/borrar cuentas de
# líder. Úsala SOLO como variable de servidor (nunca con prefijo
# NEXT_PUBLIC_, o quedaría expuesta en el navegador de cualquier visitante).
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# Clave de 32 bytes en hexadecimal (64 caracteres) para cifrar las
# contraseñas del sistema externo antes de guardarlas en la base de datos.
# Genérala una sola vez con: openssl rand -hex 32
# NUNCA la subas a un repositorio público ni la compartas.
ENCRYPTION_KEY=721e6d461f11181d2c27a229ad5f70b58d531be1e0b470d9d6c968243d34daf8
